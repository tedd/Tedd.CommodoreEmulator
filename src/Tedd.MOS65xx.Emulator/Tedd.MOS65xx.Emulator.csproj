<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Package.props" />

  <PropertyGroup>
    <TargetFrameworks>net11.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Tedd.MOS65xx.Emulator</RootNamespace>
    <Description>Cycle-exact Commodore 64 and Commodore 128 emulator core: NMOS 6502/6510/8502 and Z80 CPUs, VIC-II/VIC-IIe, VDC 8563, SID 6581, CIA 6526, MMU 8722, a real 1541 drive (its own 6502, VIAs and GCR disk mechanics), D64/T64/PRG/CRT media and a 6502 assembler. No UI, no dependencies.</Description>
  </PropertyGroup>

</Project>
