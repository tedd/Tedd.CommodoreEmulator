<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Tedd.Commodore.Sdl</RootNamespace>
    <AssemblyName>Tedd.Commodore.Sdl</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Description>Cross-platform SDL2 front-end for the Tedd.Commodore C64 emulator (Windows, Linux, macOS).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SDL2# (C# bindings, namespace SDL2) bundled with the native SDL2 libraries for
      win-x64/x86/arm64, linux-x64/x86 and osx-x64/arm64, so `dotnet publish -r <rid>` is all that is needed.
    -->
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tedd.Commodore.Hosting\Tedd.Commodore.Hosting.csproj" />
  </ItemGroup>

</Project>
