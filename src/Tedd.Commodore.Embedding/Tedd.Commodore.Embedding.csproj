<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The emulator as a library for programs that draw and play it themselves: a Vulkan (or Direct3D, OpenGL,
    WebGPU) game, an Avalonia application, a video encoder. No UI or graphics dependencies: frames are written as
    raw BGRA/RGBA/palette-index bytes into memory the host owns (a mapped staging buffer, a locked bitmap), audio
    is read as float or 16-bit PCM from the host's audio callback.

    net11.0 for current .NET; netstandard2.1 for everything else (.NET 8-10 applications pick it automatically,
    and so do engines that load .NET Standard assemblies). Both are built from the same sources.
  -->
  <Import Project="..\Package.props" />

  <PropertyGroup>
    <TargetFrameworks>net11.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Tedd.Commodore.Embedding</RootNamespace>
    <Description>Embeds the cycle-exact Commodore 64/128 emulator Tedd.CommodoreEmulator in games and applications that render and play it themselves: raw BGRA/RGBA/palette-index frames written into host memory (Vulkan staging buffers, Avalonia WriteableBitmaps, any mapped texture) and float/16-bit PCM for audio callbacks, driven from the host's game loop or its own thread.</Description>
    <PackageTags>$(PackageTags);vulkan;avalonia;embedding;game</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tedd.Commodore.Hosting\Tedd.Commodore.Hosting.csproj" />
  </ItemGroup>

</Project>
